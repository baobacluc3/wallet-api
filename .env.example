# .env
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# Database. A complete connection URL takes precedence over the individual DB_* variables.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_api

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=wallet_api

# Set to true when connecting to a managed PostgreSQL provider that requires TLS.
DB_SSL=false

# Redis (used for the access-token blacklist on logout)
REDIS_URL=redis://localhost:6379

# JWT (RS256). Generate a key pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Account lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
