# .env
JWT_SECRET=c9e9c462a41f096be6531daff81e41de5526762fe9162fb9875647ce52fe60830be6fad8ae0c0fdd73c333386c92815acb30897401ec6ff844d7b120d7605bf8
JWT_EXPIRES_IN=15m

# Database (reuse your existing wallet API connection)
DATABASE_URL=postgres://user:password@localhost:5432/wallet_api

# Redis (used for the access-token blacklist on logout)
REDIS_URL=redis://localhost:6379

# JWT (RS256). Generate a key pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then base64-encode each into the env vars below:
#   base64 -i private.pem | tr -d '\n'
#   base64 -i public.pem  | tr -d '\n'
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Account lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
