# .env
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Do not use this placeholder: startup rejects placeholder and weak secrets.
JWT_SECRET=replace-this-with-a-48-byte-random-secret-before-starting
JWT_ISSUER=wallet-api
JWT_AUDIENCE=wallet-api-clients
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Database. A complete connection URL takes precedence over the individual DB_* variables.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_api

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=wallet_api

# Set to true when connecting to a managed PostgreSQL provider that requires TLS.
# Keep certificate verification enabled; set false only with an explicitly
# trusted private CA configured by your deployment environment.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis provides the distributed authentication rate limiter. Production
# startup requires it whenever AUTH_RATE_LIMIT_ENABLED is true.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Account lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Sessions and distributed public-auth rate limits
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_IDENTIFIER_LIMIT=5
AUTH_REGISTER_IP_LIMIT=5
AUTH_REFRESH_IP_LIMIT=30

# Set to the exact number of trusted reverse proxies in front of the API.
# Leave at 0 for direct local access; do not blindly trust X-Forwarded-For.
TRUST_PROXY_HOPS=0
